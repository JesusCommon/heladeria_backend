# Configuración de entorno (copiar a .env y completar valores reales)
# NUNCA commitear el .env real (ya está en .gitignore).

APP_NAME=Heladeria Backend
APP_SLUG=heladeria-backend
APP_VERSION=0.1.0
APP_TIMEZONE=America/Bogota
APP_LOCALE=es_CO
APP_ENVIRONMENT=development   # development | staging | production | testing
APP_DEBUG=true                # NUNCA true en producción

# MongoDB
MONGODB_URL=mongodb://localhost:27018/?replicaSet=rs0
MONGODB_DATABASE=heladeria_db
MONGODB_POOL_MIN_SIZE=5
MONGODB_POOL_MAX_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000

# Seguridad: rotar con `secrets.token_hex(32)`; mínimo 32 caracteres.
# En production el valor dev por defecto hace fallar el arranque (fail closed).
SECURITY_JWT_SECRET=GENERAR_SIN_SECRETS_TOKEN_HEX_32_BYTES_MINIMO
SECURITY_JWT_TTL_MINUTES=720
SECURITY_DEVICE_LINK_TTL_MINUTES=10

# Negocio
BUSINESS_RESERVATION_TTL_SECONDS=600
BUSINESS_IDEMPOTENCY_TTL_SECONDS=86400
BUSINESS_EXPIRATION_SWEEP_SECONDS=30

# Seed del OWNER inicial (solo dev/testing; deshabilitar en producción)
ADMIN_SEED_ENABLED=true
ADMIN_SEED_OWNER_USERNAME=owner
ADMIN_SEED_OWNER_PASSWORD=heladeria-owner-123
